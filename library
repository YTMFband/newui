-- ===================== утилиты =====================

local IconFont = Font.new(
	"rbxasset://LuaPackages/Packages/_Index/BuilderIcons/BuilderIcons/BuilderIcons.json",
	Enum.FontWeight.Bold,
	Enum.FontStyle.Normal
)

local function Rand()
	local parts = table.create(8)
	for i = 1, 8 do
		parts[i] = string.char(math.random(33, 126))
	end
	return table.concat(parts)
end

local GuiClasses = {
	Frame = true, ScrollingFrame = true, CanvasGroup = true, TextLabel = true,
	TextButton = true, TextBox = true, ImageLabel = true, ImageButton = true,
}

local function New(class, props)
	local o = Instance.new(class)
	o.Name = Rand()

	if GuiClasses[class] then
		o.BorderSizePixel = 0
		if props.BackgroundTransparency == nil and props.BackgroundColor3 == nil then
			o.BackgroundTransparency = 1
		end
	end

	if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
		o.Font = Enum.Font.GothamMedium
		o.TextSize = 13
		o.TextColor3 = Theme.Text
		if class == "TextButton" then
			o.AutoButtonColor = false
		end
	end

	local parent = props.Parent
	for k, v in next, props do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	o.Parent = parent

	return o
end

local function IconLabel(props)
	props.FontFace = IconFont
	props.TextSize = props.TextSize or 16
	return New("TextLabel", props)
end

local function Corner(p, r)
	return New("UICorner", { CornerRadius = UDim.new(0, r), Parent = p })
end

local function Stroke(p, color, transparency)
	return New("UIStroke", {
		Color = color or Theme.Stroke,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = p,
	})
end

local function Pad(p, l, t, r, b)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b),
		Parent = p,
	})
end

local function List(p, padding, dir, halign, valign)
	return New("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		FillDirection = dir or Enum.FillDirection.Vertical,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = p,
	})
end

local function Tween(o, props, t)
	TweenService:Create(o, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
end

local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Blossom.Signals, c)
	return c
end

-- вызывает fn сразу и повторно при смене акцентного цвета
local function Themed(fn)
	table.insert(Blossom.Themed, fn)
	fn()
end

function Blossom:SetAccent(color)
	Theme.Accent = color
	for _, fn in ipairs(self.Themed) do
		pcall(fn)
	end
end

local WidthCache = {}
local function TextWidth(text, size)
	local key = text .. "\0" .. size
	local hit = WidthCache[key]
	if not hit then
		hit = TextService:GetTextSize(text, size, Enum.Font.GothamMedium, Vector2.new(1000, 100)).X
		WidthCache[key] = hit
	end
	return hit
end

local function Round(v, step, min)
	step = step or 1
	min = min or 0
	local r = math.floor((v - min) / step + 0.5) * step + min
	local dec = tostring(step):match("%.(%d+)")
	return tonumber(string.format("%." .. (dec and #dec or 0) .. "f", r))
end

-- перетаскивание (слайдеры, SV-квадрат, полоса оттенка)
local function BindDrag(hit, fn)
	Connect(hit.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			fn(i)

			local move, stop
			move = UserInputService.InputChanged:Connect(function(m)
				if m.UserInputType == Enum.UserInputType.MouseMovement or m.UserInputType == Enum.UserInputType.Touch then
					fn(m)
				end
			end)
			stop = UserInputService.InputEnded:Connect(function(e)
				if e.UserInputType == Enum.UserInputType.MouseButton1 or e.UserInputType == Enum.UserInputType.Touch then
					move:Disconnect()
					stop:Disconnect()
				end
			end)
		end
	end)
end

-- перетаскивание окон
local function MakeDraggable(handle, target)
	local dragging, start, origin

	Connect(handle.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			start = i.Position
			origin = target.Position
		end
	end)

	Connect(UserInputService.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - start
			target.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
		end
	end)

	Connect(UserInputService.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

-- имена клавиш
local KeyAlias = {
	LeftShift = "LShift", RightShift = "RShift", LeftControl = "LCtrl", RightControl = "RCtrl",
	LeftAlt = "LAlt", RightAlt = "RAlt", Return = "Enter", Backspace = "Bksp", Escape = "Esc",
	CapsLock = "Caps", Delete = "Del", Insert = "Ins", PageUp = "PgUp", PageDown = "PgDn",
	MouseButton1 = "M1", MouseButton2 = "M2", MouseButton3 = "M3",
	Zero = "0", One = "1", Two = "2", Three = "3", Four = "4",
	Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9",
}

local function KeyText(key)
	if not key then
		return "None"
	end
	return KeyAlias[key] or key
end

local function InputName(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.Keyboard then
		return input.KeyCode.Name
	elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
		return t.Name
	end
	return nil
end

-- позиция всплывающего окна рядом с элементом (в координатах Overlay)
local function PlacePopup(window, popup, anchor, width, height, alignRight)
	local root = window.Gui.AbsoluteSize
	local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize

	local x = alignRight and (ap.X + as.X - width) or ap.X
	x = math.clamp(x, 6, math.max(6, root.X - width - 6))

	local y = ap.Y + as.Y + 4
	if y + height > root.Y - 6 then
		y = ap.Y - height - 4
	end

	popup.Position = UDim2.fromOffset(x, math.max(6, y))
	popup.Size = UDim2.fromOffset(width, height)
end


----------------------------------------------------------------------
-- Утилиты
----------------------------------------------------------------------

local function New(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function Tween(inst, props, t)
	local tw = TweenService:Create(inst, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function Corner(parent, r)
	return New("UICorner", { CornerRadius = UDim.new(0, r or 4), Parent = parent })
end

local function Stroke(parent, color, thickness)
	return New("UIStroke", {
		Color = color or T.Stroke,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

-- Градиент акцента: ледяной голубой -> перивинкл -> сиреневый (как буква S на иконке)
local function Gradient(parent, rotation)
	return New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, T.AccentLight),
			ColorSequenceKeypoint.new(0.55, T.Accent),
			ColorSequenceKeypoint.new(1, T.AccentDark),
		}),
		Rotation = rotation or 0,
		Parent = parent,
	})
end

local function Pad(parent, l, t, r, b)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
		Parent = parent,
	})
end

local function List(parent, pad)
	return New("UIListLayout", {
		Padding = UDim.new(0, pad or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

local function Safe(fn, ...)
	if type(fn) ~= "function" then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[UILib] ошибка в callback: " .. tostring(err))
	end
end

local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library._connections, c)
	return c
end

-- ScreenGui создаётся с IgnoreGuiInset=true. Мышь берём из GetMouseLocation (экранные координаты),
-- для касаний добавляем inset к input.Position.
local function PointerPos(pos, input)
	if input and input.UserInputType ~= Enum.UserInputType.Touch then
		return UIS:GetMouseLocation()
	end
	return Vector2.new(pos.X, pos.Y) + GuiService:GetGuiInset()
end


local function IsPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function GetGuiParent()
	-- Основной вариант: CoreGui
	local CoreGui = game:GetService("CoreGui")
	local ok = pcall(function()
		local f = Instance.new("Folder")
		f.Parent = CoreGui
		f:Destroy()
	end)
	if ok then
		return CoreGui
	end
	-- Запасные варианты, если CoreGui недоступен
	if typeof(gethui) == "function" then
		local ok2, r = pcall(gethui)
		if ok2 and r then
			return r
		end
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- Общий drag: один активный обработчик на всю библиотеку
local activeDrag
local function BeginDrag(fn)
	activeDrag = fn
end

-- Поведение onChanged / callback
local function AttachChanged(obj)
	obj._changed = {}
	function obj:OnChanged(fn)
		table.insert(self._changed, fn)
		return self
	end
	function obj:_fire(...)
		local args = table.pack(...)
		if args.n == 0 then
			args = table.pack(self.Value)
		end
		Safe(self._callback, table.unpack(args, 1, args.n))
		for _, fn in ipairs(self._changed) do
			Safe(fn, table.unpack(args, 1, args.n))
		end
	end
end

local function Register(id, obj)
	if not id then
		return
	end
	obj.Id = id
	if obj.Type == "Toggle" then
		Library.Toggles[id] = obj
	else
		Library.Options[id] = obj
	end
end

----------------------------------------------------------------------
-- Инициализация общего GUI, попапы, уведомления
----------------------------------------------------------------------

function Library:_init()
	if self.Gui then
		return
	end
	local gui = New("ScreenGui", {
		Name = HttpService:GenerateGUID(false),
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1000,
	})
	pcall(function()
		if syn and syn.protect_gui then
			syn.protect_gui(gui)
		end
	end)
	gui.Parent = GetGuiParent()
	self.Gui = gui

	self.Overlay = New("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 100,
		Parent = gui,
	})

	self.Notifs = New("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -14),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 120,
		Parent = gui,
	})
	List(self.Notifs, 6)

	Connect(UIS.InputChanged, function(input)
		if
			activeDrag
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			activeDrag(input.Position, input)
		end
	end)

	Connect(UIS.InputEnded, function(input)
		if IsPress(input) then
			activeDrag = nil
		end
	end)

end

function Library:_closeTop()
	local p = table.remove(self._popups)
	if p then
		p.frame.Visible = false
		if p.blocker then
			p.blocker:Destroy()
		end
		Safe(p.onClose)
	end
end

function Library:CloseAllPopups()
	while #self._popups > 0 do
		self:_closeTop()
	end
end

function Library:_isOpen(frame)
	for _, p in ipairs(self._popups) do
		if p.frame == frame then
			return true
		end
	end
	return false
end

function Library:_closeFrame(frame)
	while #self._popups > 0 do
		local top = self._popups[#self._popups]
		self:_closeTop()
		if top.frame == frame then
			break
		end
	end
end

function Library:_openPopup(frame, owner, onClose)
	while #self._popups > 0 do
		local top = self._popups[#self._popups]
		if top.frame == frame then
			return
		end
		if owner:IsDescendantOf(top.frame) then
			break
		end
		self:_closeTop()
	end
	-- Невидимый «блокер» на весь экран под попапом: клик мимо закрывает попап,
	-- координаты курсора для этого не нужны.
	local depth = #self._popups + 1
	local blocker = New("TextButton", {
		Name = "Blocker",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = depth * 2 - 1,
		Parent = self.Overlay,
	})
	blocker.InputBegan:Connect(function(input)
		if IsPress(input) then
			self:_closeFrame(frame)
		end
	end)
	frame.ZIndex = depth * 2
	frame.Position = UDim2.fromOffset(
		owner.AbsolutePosition.X,
		owner.AbsolutePosition.Y + owner.AbsoluteSize.Y + 4
	)
	frame.Visible = true
	table.insert(self._popups, { frame = frame, owner = owner, onClose = onClose, blocker = blocker })
	task.defer(function()
		if not frame.Parent then
			return
		end
		local vp = self.Overlay.AbsoluteSize
		local s = frame.AbsoluteSize
		local x = math.clamp(frame.AbsolutePosition.X, 4, math.max(4, vp.X - s.X - 4))
		local y = frame.AbsolutePosition.Y
		if y + s.Y > vp.Y - 4 then
			y = math.max(4, owner.AbsolutePosition.Y - s.Y - 4)
		end
		frame.Position = UDim2.fromOffset(x, y)
	end)
end

function Library:_togglePopup(frame, owner, onClose)
	if self:_isOpen(frame) then
		self:_closeFrame(frame)
	else
		self:_openPopup(frame, owner, onClose)
	end
end

function Library:Notify(text, duration)
	self:_init()
	local n = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Background,
		Parent = self.Notifs,
	})
	Corner(n, 6)
	Stroke(n)
	Pad(n, 12, 8, 10, 8)
	New("Frame", {
		Size = UDim2.new(0, 2, 1, 0),
		Position = UDim2.fromOffset(-8, 0),
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
		Parent = n,
	})
	New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Text = tostring(text),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = T.Text,
		Font = T.Font,
		TextSize = T.TextSize,
		Parent = n,
	})
	task.delay(duration or 4, function()
		if n.Parent then
			n:Destroy()
		end
	end)
end

----------------------------------------------------------------------
-- Конфиги
----------------------------------------------------------------------

function Library:Serialize()
	local data = {}
	for id, t in pairs(self.Toggles) do
		data[id] = { Type = "Toggle", Value = t.Value }
	end
	for id, o in pairs(self.Options) do
		if o.Type == "ColorPicker" then
			data[id] = { Type = o.Type, Value = o.Value:ToHex(), Alpha = o.Transparency }
		elseif o.Type == "Keybind" then
			data[id] = { Type = o.Type, Value = o.Value and o.Value.Name or "", Mode = o.Mode }
		elseif o.Type == "Slider" or o.Type == "Dropdown" or o.Type == "Textbox" then
			data[id] = { Type = o.Type, Value = o.Value }
		end
	end
	return data
end

function Library:Deserialize(data)
	for id, d in pairs(data) do
		local obj = self.Toggles[id] or self.Options[id]
		if obj and obj.Type == d.Type then
			if d.Type == "ColorPicker" then
				pcall(function()
					obj:SetValue(Color3.fromHex(d.Value), false, d.Alpha)
				end)
			elseif d.Type == "Keybind" then
				obj.Mode = d.Mode or obj.Mode
				obj:SetValue(d.Value ~= "" and d.Value or nil)
			else
				obj:SetValue(d.Value)
			end
		end
	end
end

function Library:SaveConfig(name)
	local json = HttpService:JSONEncode(self:Serialize())
	if writefile then
		if makefolder and isfolder and not isfolder("UILib") then
			makefolder("UILib")
		end
		writefile("UILib/" .. name .. ".json", json)
	end
	return json
end

function Library:LoadConfig(name)
	if not (readfile and isfile and isfile("UILib/" .. name .. ".json")) then
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile("UILib/" .. name .. ".json"))
	end)
	if ok then
		self:Deserialize(data)
	end
	return ok
end

function Library:Unload()
	for _, c in ipairs(self._connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	if self.Gui then
		self.Gui:Destroy()
	end
	self.Gui = nil
	table.clear(self._connections)
	table.clear(self._popups)
	table.clear(self.Toggles)
	table.clear(self.Options)
end


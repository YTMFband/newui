function SectionClass:AddDropdown(cfg)
	cfg = cfg or {}

	local window = self.Window
	local name = cfg.Name or "Dropdown"
	local D = { Type = "Dropdown", Values = cfg.Values or {}, Multi = cfg.Multi == true }
	local selected = {}
	local itemButtons = {}

	local row = self:_Row(name, 48)

	New("TextLabel", {
		Text = name, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 18), Parent = row,
	})

	local field = New("TextButton", {
		Text = "", BackgroundColor3 = Theme.Field, Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 26), Parent = row,
	})
	Corner(field, 5)
	Stroke(field, Theme.Stroke, 0.3)

	local valueLabel = New("TextLabel", {
		Text = "None", TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(9, 0),
		Size = UDim2.new(1, -32, 1, 0), Parent = field,
	})

	IconLabel({
		Text = "grid", TextSize = 14, TextColor3 = Theme.SubText,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -7, 0.5, 0),
		Size = UDim2.fromOffset(16, 16), Parent = field,
	})

	local popup = New("Frame", { BackgroundColor3 = Theme.Popup, Visible = false, ZIndex = 2, Parent = window.Overlay })
	Corner(popup, 6)
	Stroke(popup, Theme.Stroke, 0.2)

	local scroll = New("ScrollingFrame", {
		Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Stroke, Parent = popup,
	})
	List(scroll, 2)

	local function styleItems()
		for v, b in pairs(itemButtons) do
			local on = selected[v] == true
			b.TextColor3 = on and Theme.Accent or Theme.Text
			b.TextTransparency = on and 0 or 0.25
		end
	end
	Themed(styleItems)

	local function refreshLabel()
		local value = D:Get()
		if D.Multi then
			valueLabel.Text = (#value > 0) and table.concat(value, ", ") or "None"
		else
			valueLabel.Text = value ~= nil and tostring(value) or "None"
		end
		styleItems()
	end

	local function fire()
		if cfg.Callback then
			task.spawn(cfg.Callback, D:Get())
		end
	end

	local function build()
		for _, b in pairs(itemButtons) do
			b:Destroy()
		end
		table.clear(itemButtons)

		for i, val in ipairs(D.Values) do
			local b = New("TextButton", {
				Text = tostring(val), TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundColor3 = Theme.Card, BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 22), LayoutOrder = i, Parent = scroll,
			})
			Corner(b, 4)
			Pad(b, 8, 0, 8, 0)
			itemButtons[val] = b

			b.MouseEnter:Connect(function() Tween(b, { BackgroundTransparency = 0 }, 0.1) end)
			b.MouseLeave:Connect(function() Tween(b, { BackgroundTransparency = 1 }, 0.1) end)

			b.MouseButton1Click:Connect(function()
				if D.Multi then
					selected[val] = (not selected[val]) or nil
				else
					table.clear(selected)
					selected[val] = true
				end

				refreshLabel()
				fire()

				if not D.Multi then
					window:_Close()
				end
			end)
		end

		styleItems()
	end

	function D:Get()
		if D.Multi then
			local out = {}
			for _, val in ipairs(D.Values) do
				if selected[val] then
					table.insert(out, val)
				end
			end
			return out
		end

		for val in pairs(selected) do
			return val
		end
		return nil
	end

	function D:Set(value, silent)
		table.clear(selected)

		if type(value) == "table" then
			for _, val in ipairs(value) do
				selected[val] = true
			end
		elseif value ~= nil then
			selected[value] = true
		end

		refreshLabel()
		if not silent then
			fire()
		end
	end

	function D:SetValues(values, keep)
		D.Values = values or {}
		if not keep then
			table.clear(selected)
		end
		build()
		refreshLabel()
	end

	field.MouseButton1Click:Connect(function()
		local h = math.min(#D.Values, cfg.MaxVisible or 6) * 24 + 6
		PlacePopup(window, popup, field, field.AbsoluteSize.X, h, false)
		window:_Open(popup)
	end)

	build()
	D:Set(cfg.Default, true)

	if cfg.Flag then
		Blossom.Flags[cfg.Flag] = D
	end

	return D
end


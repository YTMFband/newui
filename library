-- ===================== Keybind (с окном режимов) =====================

local GuiService = Service("GuiService")

-- координаты указателя в системе ScreenGui с IgnoreGuiInset
local function PointerY(input)
	return input.Position.Y + GuiService:GetGuiInset().Y
end

local function MakeKeybind(window, parent, cfg, display)
	cfg = cfg or {}

	local K = {
		Type = "Keybind",
		Key = cfg.Default,
		Mode = (cfg.Mode == "Hold") and "Hold" or "Toggle",
		State = false,
		Name = cfg.Name or display or "Keybind",
	}

	local OnState = cfg.OnState or function() end
	local OnKey = cfg.Callback or function() end
	local binding = false
	local suppress = false

	local box = New("TextButton", {
		Text = KeyText(K.Key), TextSize = 11, TextColor3 = Theme.SubText,
		BackgroundColor3 = Theme.Field, Size = UDim2.fromOffset(22, 16), Parent = parent,
	})
	Corner(box, 4)
	Stroke(box, Theme.Stroke, 0.3)

	local function resize()
		box.Size = UDim2.fromOffset(math.max(22, TextWidth(box.Text, 11) + 10), 16)
	end
	resize()

	-- окно: On Toggle / On Hold / Reset
	local popup = New("Frame", { BackgroundColor3 = Theme.Popup, Visible = false, ZIndex = 2, Parent = window.Overlay })
	Corner(popup, 8)
	Stroke(popup, Theme.Stroke, 0.2)

	local function popupButton(text, pos, size)
		local b = New("TextButton", {
			Text = text, TextSize = 12, TextTransparency = 0.35,
			BackgroundColor3 = Theme.Card, Position = pos, Size = size, Parent = popup,
		})
		Corner(b, 5)
		return b
	end

	local toggleBtn = popupButton("On Toggle", UDim2.new(0, 5, 0, 5), UDim2.new(0.5, -7, 0, 26))
	local holdBtn = popupButton("On Hold", UDim2.new(0.5, 2, 0, 5), UDim2.new(0.5, -7, 0, 26))
	local resetBtn = popupButton("Reset", UDim2.new(0, 5, 0, 35), UDim2.new(1, -10, 0, 26))
	resetBtn.TextTransparency = 0.1

	IconLabel({
		Text = "arrow-rotate-right", TextSize = 14, TextColor3 = Theme.SubText,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, -28, 0.5, 0),
		Size = UDim2.fromOffset(16, 16), Parent = resetBtn,
	})

	local function refreshModes()
		for btn, mode in pairs({ [toggleBtn] = "Toggle", [holdBtn] = "Hold" }) do
			local on = K.Mode == mode
			Tween(btn, {
				BackgroundColor3 = on and Theme.Accent or Theme.Card,
				TextTransparency = on and 0 or 0.35,
			}, 0.12)
		end
	end
	Themed(refreshModes)

	function K:SetState(v, silent)
		v = v and true or false
		if K.State == v then
			return
		end
		K.State = v
		window:_HotkeyUpdate(K)
		if not silent then
			task.spawn(OnState, v)
		end
	end

	function K:SetKey(key, silent)
		K.Key = key
		box.Text = KeyText(key)
		resize()
		if not silent then
			task.spawn(OnKey, key)
		end
	end

	function K:SetMode(mode, silent)
		local new = (mode == "Hold") and "Hold" or "Toggle"
		local changed = new ~= K.Mode
		K.Mode = new
		refreshModes()
		window:_HotkeyUpdate(K)
		if changed and K.State then
			K:SetState(false, silent)
		end
	end

	function K:Get()
		return { Key = K.Key, Mode = K.Mode }
	end

	function K:Set(v)
		if type(v) == "table" then
			K:SetKey(v.Key, true)
			K:SetMode(v.Mode, true)
		end
	end

	toggleBtn.MouseButton1Click:Connect(function() K:SetMode("Toggle") end)
	holdBtn.MouseButton1Click:Connect(function() K:SetMode("Hold") end)
	resetBtn.MouseButton1Click:Connect(function()
		K:SetKey(nil)
		K:SetMode("Toggle")
		K:SetState(false)
		window:_Close()
	end)

	local function openPopup()
		refreshModes()
		PlacePopup(window, popup, box, 190, 66, false)
		window:_Open(popup)
	end

	-- ПКМ открывает окно режимов, ЛКМ - назначение клавиши
	box.MouseButton2Click:Connect(openPopup)

	-- долгое нажатие для телефонов
	local held
	box.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch then
			local id = {}
			held = id
			task.delay(0.45, function()
				if held == id then
					suppress = true
					openPopup()
					task.delay(0.3, function() suppress = false end)
				end
			end)
		end
	end)
	box.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch then
			held = nil
		end
	end)

	box.MouseButton1Click:Connect(function()
		if binding or suppress then
			return
		end

		binding = true
		box.Text = "..."
		resize()

		local conn
		conn = UserInputService.InputBegan:Connect(function(input)
			local n = InputName(input)
			if not n then
				return
			end

			conn:Disconnect()
			task.defer(function() binding = false end)

			if n == "Escape" or n == "Backspace" then
				K:SetKey(nil)
			else
				K:SetKey(n)
			end
		end)
	end)

	-- срабатывание бинда
	Connect(UserInputService.InputBegan, function(input, processed)
		if processed or binding or not K.Key or InputName(input) ~= K.Key then
			return
		end

		if K.Mode == "Hold" then
			K:SetState(true)
		else
			K:SetState(not K.State)
		end
	end)

	Connect(UserInputService.InputEnded, function(input)
		if K.Mode == "Hold" and K.Key and InputName(input) == K.Key then
			K:SetState(false)
		end
	end)

	if cfg.Flag then
		Blossom.Flags[cfg.Flag] = K
	end

	return K
end

-- ===================== ColorPicker =====================

local function MakeColorPicker(window, parent, cfg)
	cfg = cfg or {}

	local C = { Type = "ColorPicker" }
	local callback = cfg.Callback or function() end
	local h, s, v = (cfg.Default or Theme.Accent):ToHSV()
	local color = Color3.fromHSV(h, s, v)

	local swatch = New("TextButton", { Text = "", BackgroundColor3 = color, Size = UDim2.fromOffset(22, 14), Parent = parent })
	Corner(swatch, 4)
	Stroke(swatch, Theme.Stroke, 0.3)

	local popup = New("Frame", { BackgroundColor3 = Theme.Popup, Visible = false, ZIndex = 2, Parent = window.Overlay })
	Corner(popup, 8)
	Stroke(popup, Theme.Stroke, 0.2)

	local sv = New("Frame", {
		BackgroundColor3 = Color3.fromHSV(h, 1, 1), Position = UDim2.fromOffset(9, 9),
		Size = UDim2.new(1, -18, 0, 110), Parent = popup,
	})
	Corner(sv, 4)

	local white = New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), Parent = sv })
	Corner(white, 4)
	New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })

	local black = New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.fromScale(1, 1), Parent = sv })
	Corner(black, 4)
	New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })

	local cursor = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(9, 9), Parent = sv,
	})
	Corner(cursor, 5)
	Stroke(cursor, Color3.new(0, 0, 0), 0.3)

	local hue = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(9, 127),
		Size = UDim2.new(1, -18, 0, 10), Parent = popup,
	})
	Corner(hue, 5)
	New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hue,
	})

	local hueKnob = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(4, 14), Parent = hue,
	})
	Corner(hueKnob, 2)
	Stroke(hueKnob, Color3.new(0, 0, 0), 0.4)

	local hex = New("TextBox", {
		Text = "", ClearTextOnFocus = false, TextSize = 12, TextColor3 = Theme.SubText,
		BackgroundColor3 = Theme.Field, Position = UDim2.fromOffset(9, 146),
		Size = UDim2.new(1, -18, 0, 22), Parent = popup,
	})
	Corner(hex, 5)

	local function apply(fire)
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		cursor.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.fromScale(h, 0.5)

		if not hex:IsFocused() then
			hex.Text = string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
		end

		if fire then
			task.spawn(callback, color)
		end
	end

	BindDrag(sv, function(i)
		s = math.clamp((i.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		v = 1 - math.clamp((PointerY(i) - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		apply(true)
	end)

	BindDrag(hue, function(i)
		h = math.clamp((i.Position.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
		apply(true)
	end)

	hex.FocusLost:Connect(function()
		local code = hex.Text:gsub("#", "")
		if code:match("^%x%x%x%x%x%x$") then
			local r = tonumber(code:sub(1, 2), 16)
			local g = tonumber(code:sub(3, 4), 16)
			local b = tonumber(code:sub(5, 6), 16)
			h, s, v = Color3.fromRGB(r, g, b):ToHSV()
			apply(true)
		else
			apply(false)
		end
	end)

	swatch.MouseButton1Click:Connect(function()
		PlacePopup(window, popup, swatch, 190, 176, true)
		window:_Open(popup)
	end)

	function C:Get()
		return color
	end

	function C:Set(c, silent)
		h, s, v = c:ToHSV()
		apply(not silent)
	end

	C.Value = color
	apply(false)

	if cfg.Flag then
		Blossom.Flags[cfg.Flag] = C
	end

	return C
end

-- ===================== элементы секции =====================

function SectionClass:_Row(name, height)
	self._order += 1
	local row = New("Frame", { Size = UDim2.new(1, 0, 0, height), LayoutOrder = self._order, Parent = self.Card })
	table.insert(self.Items, { Name = name or "", Row = row })
	return row
end

-- ---------- Toggle ----------

function SectionClass:AddToggle(cfg)
	cfg = cfg or {}

	local name = cfg.Name or "Toggle"
	local row = self:_Row(name, 24)

	local T = setmetatable({
		Type = "Toggle", Value = cfg.Default == true, Section = self,
		Window = self.Window, _cfg = cfg, _name = name,
	}, ToggleClass)

	local hit = New("TextButton", { Text = "", Size = UDim2.fromScale(1, 1), Parent = row })
	local label = New("TextLabel", {
		Text = name, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -40, 1, 0), Parent = row,
	})

	T.Addons = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -38, 0.5, 0),
		Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = row,
	})
	List(T.Addons, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

	local sw = New("TextButton", {
		Text = "", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(30, 16), BackgroundColor3 = Theme.Off, Parent = row,
	})
	Corner(sw, 8)

	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), Parent = sw,
	})
	Corner(knob, 6)

	function T._render()
		Tween(sw, { BackgroundColor3 = T.Value and Theme.Accent or Theme.Off })
		Tween(knob, { Position = T.Value and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) })
		Tween(label, { TextColor3 = T.Value and Theme.Text or Theme.SubText })
	end
	Themed(T._render)

	hit.MouseButton1Click:Connect(function() T:Set(not T.Value) end)
	sw.MouseButton1Click:Connect(function() T:Set(not T.Value) end)

	if cfg.Flag then
		Blossom.Flags[cfg.Flag] = T
	end

	return T
end

function ToggleClass:Set(v, silent)
	self.Value = v and true or false
	self._render()

	if self.Keybind then
		self.Keybind:SetState(self.Value, true)
	end

	if not silent and self._cfg.Callback then
		task.spawn(self._cfg.Callback, self.Value)
	end
end

function ToggleClass:Get()
	return self.Value
end

function ToggleClass:AddKeybind(cfg)
	cfg = cfg or {}

	local user = cfg.OnState
	cfg.OnState = function(state)
		self:Set(state)
		if user then
			user(state)

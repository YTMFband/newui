-- ---------- окно: всплывающие слои ----------

function WindowClass:_Open(popup, onClose)
	self:_Close()
	self._popup = { Frame = popup, OnClose = onClose }
	self.Catcher.Visible = true
	popup.Visible = true
end

function WindowClass:_Close()
	local p = self._popup
	if not p then
		return
	end

	self._popup = nil
	self.Catcher.Visible = false
	p.Frame.Visible = false

	if p.OnClose then
		p.OnClose()
	end
end

function WindowClass:SetVisible(v)
	self.Visible = v
	self:_Close()

	if v then
		self.Main.Visible = true
		self.Scale.Scale = 0.95
		Tween(self.Scale, { Scale = 1 }, 0.15)
	else
		Tween(self.Scale, { Scale = 0.95 }, 0.12)
		task.delay(0.12, function()
			if not self.Visible then
				self.Main.Visible = false
			end
		end)
	end
end

function WindowClass:Toggle()
	self:SetVisible(not self.Visible)
end

function WindowClass:SetToggleKey(key)
	self.ToggleKey = key
end

function WindowClass:ShowHotkeys(v)
	self.HotkeyFrame.Visible = v
end

function WindowClass:_HotkeyUpdate(K)
	local entry = self._hotkeys[K]

	if K.State then
		local text = K.Name .. "  [" .. K.Mode .. "]"

		if not entry then
			entry = New("TextLabel", {
				Text = text, TextSize = 11, TextColor3 = Theme.SubText, BackgroundColor3 = Theme.Popup,
				Size = UDim2.new(0, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = 1, Parent = self.HotkeyFrame,
			})
			Corner(entry, 6)
			Stroke(entry, Theme.Stroke, 0.3)
			Pad(entry, 8, 0, 8, 0)
			self._hotkeys[K] = entry
		else
			entry.Text = text
		end
	elseif entry then
		entry:Destroy()
		self._hotkeys[K] = nil
	end
end


function Elements:AddToggle(id, o)
	o = o or {}
	local Toggle = { Type = "Toggle", Value = false, Window = self.Window, _callback = o.Callback, _hooks = {} }
	AttachChanged(Toggle)

	local row = MakeRow(self.Container, 26)
	local hit = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})
	MakeText(row, o.Text or id or "", { Size = UDim2.new(1, -30, 1, 0), Active = false })

	local right = MakeRight(row)
	Toggle._right = right

	local box = New("Frame", {
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = T.Element,
		LayoutOrder = 10,
		Parent = right,
	})
	Corner(box, 3)
	local boxStroke = Stroke(box)
	local boxGrad = Gradient(box, 45)
	boxGrad.Enabled = false
	local check = MakeText(box, "✓", {
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 11,
		Font = T.FontBold,
		Visible = false,
	})

	function Toggle:SetValue(val, silent)
		val = val == true
		self.Value = val
		check.Visible = val
		boxGrad.Enabled = val
		Tween(box, { BackgroundColor3 = val and Color3.new(1, 1, 1) or T.Element })
		Tween(boxStroke, { Color = val and T.Accent or T.Stroke })
		for _, f in ipairs(self._hooks) do
			f(val)
		end
		if not silent then
			self:_fire()
		end
	end

	function Toggle:AddColorPicker(cid, co)
		local CP = BuildColorPicker(right, co, 1)
		Register(cid, CP)
		return CP
	end

	function Toggle:AddSettings()
		if self._settings then
			return self._settings
		end
		local S = BuildSettings(self.Window, right, 2)
		S.Gear.TextColor3 = self.Value and T.Text or T.SubText
		table.insert(self._hooks, function(val)
			Tween(S.Gear, { TextColor3 = val and T.Text or T.SubText })
		end)
		self._settings = S
		return S
	end

	hit.MouseButton1Click:Connect(function()
		Toggle:SetValue(not Toggle.Value)
	end)

	Register(id, Toggle)
	Toggle:SetValue(o.Default == true, true)
	return Toggle
end


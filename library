----------------------------------------------------------------------
-- ColorPicker
----------------------------------------------------------------------

local function BuildColorPicker(right, o, order)
	o = o or {}
	local CP = {
		Type = "ColorPicker",
		Value = o.Default or Color3.fromRGB(255, 255, 255),
		_callback = o.Callback,
	}
	AttachChanged(CP)
	local h, s, v = CP.Value:ToHSV()
	local a = o.Transparency or 0 -- 0 = непрозрачный, 1 = прозрачный
	CP.Transparency = a

	local swatch = New("TextButton", {
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = CP.Value,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = order or 1,
		Parent = right,
	})
	Corner(swatch, 3)
	Stroke(swatch)

	local pop = MakePopup(176)
	Pad(pop, 8, 8, 8, 8)
	List(pop, 8)

	local sv = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 100),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = 1,
		Parent = pop,
	})
	Corner(sv, 4)
	local white = New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = sv,
	})
	Corner(white, 4)
	New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
	local black = New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = sv,
	})
	Corner(black, 4)
	New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
	local svCursor = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundTransparency = 1,
		Parent = sv,
	})
	Corner(svCursor, 4)
	Stroke(svCursor, Color3.new(1, 1, 1), 2)

	local hueBar = New("Frame", {
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = 2,
		Parent = pop,
	})
	Corner(hueBar, 4)
	New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hueBar,
	})
	local hueCursor = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(4, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = hueBar,
	})
	Corner(hueCursor, 2)
	Stroke(hueCursor, Color3.new(0, 0, 0), 1)

	local alphaBar = New("Frame", {
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundColor3 = CP.Value,
		LayoutOrder = 3,
		Parent = pop,
	})
	Corner(alphaBar, 4)
	New("UIGradient", { Transparency = NumberSequence.new(0.9, 0), Parent = alphaBar })
	local alphaCursor = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundTransparency = 1,
		Parent = alphaBar,
	})
	Corner(alphaCursor, 4)
	Stroke(alphaCursor, Color3.new(1, 1, 1), 2)

	local hex = New("TextBox", {
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = T.Element,
		TextColor3 = T.Text,
		PlaceholderText = "#FFFFFF",
		Font = T.Font,
		TextSize = 12,
		ClearTextOnFocus = false,
		LayoutOrder = 4,
		Parent = pop,
	})
	Corner(hex, 4)

	local function apply(silent)
		CP.Value = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = CP.Value
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.fromScale(h, 0.5)
		alphaBar.BackgroundColor3 = CP.Value
		alphaCursor.Position = UDim2.fromScale(1 - a, 0.5)
		CP.Transparency = a
		hex.Text = "#" .. CP.Value:ToHex():upper()
		if not silent then
			CP:_fire(CP.Value, CP.Transparency)
		end
	end

	sv.InputBegan:Connect(function(input)
		if IsPress(input) then
			local function f(pos, inp)
				local rel = PointerPos(pos, inp) - sv.AbsolutePosition
				s = math.clamp(rel.X / sv.AbsoluteSize.X, 0, 1)
				v = 1 - math.clamp(rel.Y / sv.AbsoluteSize.Y, 0, 1)
				apply()
			end
			f(input.Position, input)
			BeginDrag(f)
		end
	end)

	hueBar.InputBegan:Connect(function(input)
		if IsPress(input) then
			local function f(pos, inp)
				h = math.clamp((PointerPos(pos, inp).X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
				apply()
			end
			f(input.Position, input)
			BeginDrag(f)
		end
	end)

	alphaBar.InputBegan:Connect(function(input)
		if IsPress(input) then
			local function f(pos, inp)
				a = 1 - math.clamp((PointerPos(pos, inp).X - alphaBar.AbsolutePosition.X) / alphaBar.AbsoluteSize.X, 0, 1)
				apply()
			end
			f(input.Position, input)
			BeginDrag(f)
		end
	end)

	hex.FocusLost:Connect(function()
		local txt = (hex.Text:gsub("#", ""))
		local ok, c = pcall(Color3.fromHex, txt)
		if ok and c then
			CP:SetValue(c)
		else
			apply(true)
		end
	end)

	function CP:SetValue(c, silent, alpha)
		if typeof(c) ~= "Color3" then
			return
		end
		h, s, v = c:ToHSV()
		if alpha ~= nil then
			a = math.clamp(alpha, 0, 1)
		end
		apply(silent)
	end

	swatch.MouseButton1Click:Connect(function()
		Library:_togglePopup(pop, swatch)
	end)

	CP.Swatch = swatch
	apply(true)
	return CP
end


-- ---------- Slider ----------

function SectionClass:AddSlider(cfg)
	cfg = cfg or {}

	local name = cfg.Name or "Slider"
	local min, max = cfg.Min or 0, cfg.Max or 100
	local step = cfg.Increment or (cfg.Rounding and (10 ^ -cfg.Rounding)) or 1
	local suffix = cfg.Suffix or ""

	local S = { Type = "Slider", Value = math.clamp(cfg.Default or min, min, max) }
	local row = self:_Row(name, 38)

	New("TextLabel", {
		Text = name, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -62, 0, 18), Parent = row,
	})

	local box = New("TextBox", {
		Text = "", ClearTextOnFocus = false, TextSize = 11, TextColor3 = Theme.SubText,
		BackgroundColor3 = Theme.Field, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 1), Size = UDim2.fromOffset(54, 16), Parent = row,
	})
	Corner(box, 4)

	local track = New("Frame", {
		BackgroundColor3 = Theme.Off, Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 4), Parent = row,
	})
	Corner(track, 2)

	local fill = New("Frame", { BackgroundColor3 = Theme.Accent, Size = UDim2.fromScale(0, 1), Parent = track })
	Corner(fill, 2)
	Themed(function() fill.BackgroundColor3 = Theme.Accent end)

	local knob = New("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(10, 10), Parent = fill,
	})
	Corner(knob, 5)

	local hit = New("TextButton", {
		Text = "", Position = UDim2.fromOffset(-5, 18), Size = UDim2.new(1, 10, 0, 22), Parent = row,
	})

	local function render()
		local rel = (max > min) and ((S.Value - min) / (max - min)) or 0
		Tween(fill, { Size = UDim2.fromScale(rel, 1) }, 0.06)
		box.Text = tostring(S.Value) .. suffix
	end

	function S:Set(val, silent)
		val = math.clamp(Round(math.clamp(val, min, max), step, min), min, max)
		local changed = val ~= S.Value
		S.Value = val
		render()
		if changed and not silent and cfg.Callback then
			task.spawn(cfg.Callback, S.Value)
		end
	end

	function S:Get()
		return S.Value
	end

	BindDrag(hit, function(i)
		local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		S:Set(min + (max - min) * rel)
	end)

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text:match("-?%d+%.?%d*"))
		if n then
			S:Set(n)
		else
			render()
		end
	end)

	render()

	if cfg.Flag then
		Blossom.Flags[cfg.Flag] = S
	end

	return S
end


	})

	-- Перетаскивание
	for _, handle in ipairs({ logo, topbar }) do
		handle.InputBegan:Connect(function(input)
			if IsPress(input) then
				local startPos, startUI = input.Position, main.Position
				BeginDrag(function(pos)
					local d = pos - startPos
					main.Position = UDim2.new(
						startUI.X.Scale,
						startUI.X.Offset + d.X,
						startUI.Y.Scale,
						startUI.Y.Offset + d.Y
					)
				end)
			end
		end)
	end

	function Window:Toggle(state)
		if state == nil then
			state = not self.Visible
		end
		self.Visible = state
		main.Visible = state
		if not state then
			Library:CloseAllPopups()
		end
	end

	function Window:Destroy()
		main:Destroy()
	end

	local toggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
	Connect(UIS.InputBegan, function(input, gp)
		if not gp and input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end)

	function Window:SelectPage(page)
		Library:CloseAllPopups()
		for _, p in ipairs(self.Pages) do
			local on = p == page
			local pill = self.ActiveStyle == "Pill"
			local white = Color3.new(1, 1, 1)
			p.TabBar.Visible = on
			p.Content.Visible = on
			Tween(p.Button, {
				BackgroundColor3 = pill and T.Accent or T.Element,
				BackgroundTransparency = on and (pill and 0 or 0.5) or 1,
			})
			Tween(p.Label, { TextColor3 = on and (pill and white or T.Text) or T.SubText })
			if p.Bar then
				-- тонкая полоска у левого края, текст и фон остаются спокойными
				Tween(p.Bar, {
					Size = UDim2.fromOffset(3, on and 18 or 0),
					BackgroundTransparency = on and 0 or 1,
				})
				if pill then
					p.Bar.BackgroundColor3 = white
				end
			end
			if p.IconImage then
				Tween(p.IconImage, { ImageColor3 = on and (pill and white or T.Text) or T.SubText })
			end
			if p.Glyph then
				for _, part in ipairs(p.Glyph:GetChildren()) do
					Tween(part, { BackgroundColor3 = on and (pill and white or T.Text) or T.SubText })
				end
			end
			if on and p.Category and not p.Category.Open then
				p.Category:SetOpen(true)
			end
		end
	end

	-- Сворачиваемая категория в сайдбаре (клик по заголовку открывает/закрывает)
	function Window:AddCategory(name, copts)
		if self._cats[name] then
			return self._cats[name]
		end
		copts = copts or {}
		self._order += 1
		local Cat = { Name = name, Open = copts.Open ~= false, Pages = {}, Window = self }

		local frame = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = T.Panel,
			LayoutOrder = self._order,
			Parent = sidebar,
		})
		Corner(frame, 8)
		Stroke(frame)
		List(frame, 0)

		local header = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = 0,
			Parent = frame,
		})
		-- иконка слева от названия (необязательно): copts.Icon = "rbxassetid://..."
		if copts.Icon then
			New("ImageLabel", {
				Size = UDim2.fromOffset(14, 14),
				Position = UDim2.new(0, 10, 0.5, -7),
				BackgroundTransparency = 1,
				Image = copts.Icon,
				ImageColor3 = T.Text,
				Parent = header,
			})
		end
		MakeText(header, name, {
			Size = UDim2.new(1, copts.Icon and -54 or -34, 1, 0),
			Position = UDim2.fromOffset(copts.Icon and 30 or 10, 0),
			Font = T.FontBold,
		})
		-- иконка справа ⇅ (свою картинку можно задать: Library.Icons.Swap = "rbxassetid://...")
		local colorProp = Library.Icons.Swap and "ImageColor3" or "TextColor3"
		local arrowColor = Cat.Open and T.Text or T.SubText
		local arrow
		if Library.Icons.Swap then
			arrow = New("ImageLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -16, 0.5, 0),
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				Image = Library.Icons.Swap,
				ImageColor3 = arrowColor,
				Parent = header,
			})
		else
			arrow = New("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -16, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),
				BackgroundTransparency = 1,
				Text = "⇅",
				TextColor3 = arrowColor,
				Font = T.FontBold,
				TextSize = 15,
				Parent = header,
			})
		end

		local holder = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			LayoutOrder = 1,
			Parent = frame,
		})
		Pad(holder, 4, 2, 4, 4)
		local layout = List(holder, 2)

		local function target()
			return Cat.Open and (layout.AbsoluteContentSize.Y + 6) or 0
		end

		function Cat:SetOpen(open, instant)
			self.Open = open
			Tween(arrow, { [colorProp] = open and T.Text or T.SubText }, instant and 0 or 0.2)
			local size = UDim2.new(1, 0, 0, target())
			if instant then
				holder.Size = size
			else
				Tween(holder, { Size = size }, 0.2)
			end
		end

		function Cat:Toggle()
			self:SetOpen(not self.Open)
		end

		function Cat:AddPage(pname, popts)
			popts = popts or {}
			popts.Category = self.Name
			return Window:AddPage(pname, popts)
		end

		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			if Cat.Open then
				holder.Size = UDim2.new(1, 0, 0, target())
			end
		end)
		header.MouseButton1Click:Connect(function()
			Cat:Toggle()
		end)

		Cat.Holder = holder
		self._cats[name] = Cat
		return Cat
	end

	function Window:AddPage(name, popts)
		popts = popts or {}
		local Page = { Window = Window, Tabs = {} }

		local cat = popts.Category and Window:AddCategory(popts.Category) or nil
		local parent, order
		if cat then
			parent, order = cat.Holder, #cat.Pages + 1
			table.insert(cat.Pages, Page)
			Page.Category = cat
		else
			Window._order += 1
			parent, order = sidebar, Window._order
		end

		local btn = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundColor3 = T.Element,
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = parent,
		})
		Corner(btn, 6)
		local hasIcon = popts.Icon ~= nil
		if hasIcon then
			Page.IconImage = New("ImageLabel", {
				Size = UDim2.fromOffset(14, 14),
				Position = UDim2.new(0, 10, 0.5, -7),
				BackgroundTransparency = 1,
				Image = popts.Icon,
				ImageColor3 = T.SubText,
				Parent = btn,
			})
		elseif Window.ActiveStyle == "Pill" or cat then
			-- уголок «↳» рисуем рамками, потому что шрифт его не отображает
			Page.Glyph = New("Frame", {
				Size = UDim2.fromOffset(8, 8),
				Position = UDim2.new(0, 11, 0.5, -5),
				BackgroundTransparency = 1,
				Parent = btn,
			})
			New("Frame", {
				Size = UDim2.new(0, 1, 1, 0),
				BackgroundColor3 = T.SubText,
				BorderSizePixel = 0,
				Parent = Page.Glyph,
			})
			New("Frame", {
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = T.SubText,
				BorderSizePixel = 0,
				Parent = Page.Glyph,
			})
		end
		if Window.ActiveStyle ~= "Pill" then
			-- тонкая акцентная полоска у левого края активной страницы
			Page.Bar = New("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, cat and -4 or 0, 0.5, 0),
				Size = UDim2.fromOffset(3, 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = btn,
			})
			Corner(Page.Bar, 2)
			Gradient(Page.Bar, 90)
		end
		local indent = (hasIcon or Window.ActiveStyle == "Pill" or cat ~= nil) and 30 or 12
		local lbl = MakeText(btn, name, {
			Size = UDim2.new(1, -(indent + 4), 1, 0),
			Position = UDim2.fromOffset(indent, 0),
			TextColor3 = T.SubText,
		})
		Page.Button, Page.Label = btn, lbl

		Page.TabBar = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = topbar,
		})
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = Page.TabBar,
		})
		Pad(Page.TabBar, 8, 0, 8, 0)

		Page.Content = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = content,
		})

		function Page:SelectTab(tab)
			Library:CloseAllPopups()
			for _, t in ipairs(self.Tabs) do
				local on = t == tab
				t.Scroll.Visible = on
				Tween(t.Button, { BackgroundTransparency = on and 0 or 1 })
				Tween(t.Button, { TextColor3 = on and T.Text or T.SubText })
				t.Line.Visible = on
			end
		end

		function Page:AddTab(tabName)
			local Tab = { Page = Page, Window = Window }

			local tb = New("TextButton", {
				Size = UDim2.fromOffset(0, 26),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = T.Element,
				BackgroundTransparency = 1,
				Text = tabName,
				TextColor3 = T.SubText,
				Font = T.Font,
				TextSize = T.TextSize,
				AutoButtonColor = false,
				LayoutOrder = #Page.Tabs + 1,
				Parent = Page.TabBar,
			})
			Corner(tb, 6)
			Pad(tb, 12, 0, 12, 0)
			local line = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, 0),
				Size = UDim2.new(1, -24, 0, 2),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Visible = false,
				Parent = tb,
			})
			Corner(line, 1)
			Gradient(line, 0)
			Tab.Button, Tab.Line = tb, line

			local scroll = New("ScrollingFrame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 2,
				ScrollBarImageColor3 = T.Stroke,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				Visible = false,
				Parent = Page.Content,
			})
			scroll.ScrollingDirection = Enum.ScrollingDirection.Y
			local holder = New("Frame", {
				Position = UDim2.fromOffset(8, 4),
				Size = UDim2.new(1, -16, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Parent = scroll,
			})
			Pad(holder, 0, 0, 0, 12)
			New("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = holder,
			})
			local function column(order)
				local c = New("Frame", {
					Size = UDim2.new(0.5, -4, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					LayoutOrder = order,
					Parent = holder,
				})
				List(c, 8)
				return c
			end
			Tab.Scroll, Tab.Left, Tab.Right = scroll, column(1), column(2)

			function Tab:AddGroup(g)
				if type(g) == "string" then
					g = { Name = g }
				end
				g = g or {}
				local Group = { Type = "Group", Window = Window, Tab = Tab, _callback = g.Callback, Value = false }
				AttachChanged(Group)

				local frame = New("Frame", {
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundColor3 = T.Panel,
					Parent = (g.Side == "Right") and Tab.Right or Tab.Left,
				})
				Corner(frame, 8)
				Stroke(frame)
				List(frame, 0)

				local header = New("Frame", {
					Size = UDim2.new(1, 0, 0, 32),
					BackgroundTransparency = 1,
					LayoutOrder = 0,
					Parent = frame,
				})
				local iconId = g.Icon or Library.Icons.Group
				if iconId then
					New("ImageLabel", {
						Size = UDim2.fromOffset(16, 16),
						Position = UDim2.new(0, 10, 0.5, -8),
						BackgroundTransparency = 1,
						Image = iconId,
						ImageColor3 = T.Accent,
						Parent = header,
					})
				end
				MakeText(header, g.Name or "Group", {
					Size = UDim2.new(1, -70, 1, 0),
					Position = UDim2.fromOffset(iconId and 32 or 12, 0),
					Font = T.FontBold,
				})

				if g.Toggle ~= nil then
					local sw = New("TextButton", {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -10, 0.5, 0),
						Size = UDim2.fromOffset(28, 14),
						BackgroundColor3 = T.Element,
						Text = "",
						AutoButtonColor = false,
						Parent = header,
					})
					Corner(sw, 7)
					local knob = New("Frame", {
						AnchorPoint = Vector2.new(0, 0.5),
						Position = UDim2.new(0, 2, 0.5, 0),
						Size = UDim2.fromOffset(10, 10),
						BackgroundColor3 = T.SubText,
						Parent = sw,
					})
					Corner(knob, 5)
					local swGrad = Gradient(sw, 0)
					swGrad.Enabled = false
					function Group:SetEnabled(val, silent)
						val = val == true
						self.Value = val
						swGrad.Enabled = val
						Tween(sw, { BackgroundColor3 = val and Color3.new(1, 1, 1) or T.Element })
						Tween(knob, {
							Position = val and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
							BackgroundColor3 = val and Color3.new(1, 1, 1) or T.SubText,
						})
						if not silent then
							self:_fire()
						end
					end
					sw.MouseButton1Click:Connect(function()
						Group:SetEnabled(not Group.Value)
					end)
					Group:SetEnabled(g.Toggle == true, true)
				end

				local body = New("Frame", {
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					LayoutOrder = 1,
					Parent = frame,
				})
				Pad(body, 12, 0, 12, 10)
				List(body, 4)

				Group.Container = body
				Mixin(Group)
				if g.Id then
					Register(g.Id, Group)
				end
				return Group
			end

			table.insert(Page.Tabs, Tab)
			tb.MouseButton1Click:Connect(function()
				Page:SelectTab(Tab)
			end)
			if #Page.Tabs == 1 then
				Page:SelectTab(Tab)
			end
			return Tab
		end

		table.insert(Window.Pages, Page)
		btn.MouseButton1Click:Connect(function()
			Window:SelectPage(Page)
		end)
		if #Window.Pages == 1 then
			Window:SelectPage(Page)
		end
		return Page
	end

	table.insert(self.Windows, Window)
	return Window
end

return Library

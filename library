function WindowClass:SelectTab(tab)
	self:_Close()

	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		t.Page.Visible = on
		Tween(t.Button, { BackgroundTransparency = on and 0 or 1 }, 0.12)
		Tween(t.Label, { TextColor3 = on and Theme.Text or Theme.SubText }, 0.12)
		if t.Icon then
			Tween(t.Icon, { TextColor3 = on and Theme.Text or Theme.SubText }, 0.12)
		end
	end

	self.CurrentTab = tab
	self:_ApplySearch()
end

function WindowClass:_ApplySearch()
	local tab = self.CurrentTab
	if not tab then
		return
	end

	local q = string.lower(self.Search.Text)

	for _, sec in ipairs(tab.Sections) do
		local any = false

		for _, item in ipairs(sec.Items) do
			local match = q == "" or string.find(string.lower(item.Name), q, 1, true) ~= nil
			item.Row.Visible = match
			any = any or match
		end

		sec.Holder.Visible = q == "" or any
	end
end

function TabClass:AddSection(cfg)
	cfg = cfg or {}

	local column = (cfg.Side == "Right") and self.Right or self.Left

	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = #self.Sections + 1, Parent = column,
	})
	List(holder, 6)

	local head = New("Frame", { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, Parent = holder })
	local x = 2

	if cfg.Icon then
		IconLabel({
			Text = cfg.Icon, TextSize = 14, TextColor3 = Theme.SubText,
			Position = UDim2.fromOffset(2, 0), Size = UDim2.fromOffset(16, 20), Parent = head,
		})
		x = 22
	end

	New("TextLabel", {
		Text = cfg.Name or "Section", TextColor3 = Theme.SubText, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(x, 0),
		Size = UDim2.new(1, -x, 1, 0), Parent = head,
	})

	local card = New("Frame", {
		BackgroundColor3 = Theme.Card, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = holder,
	})
	Corner(card, 8)
	Stroke(card, Theme.Stroke, 0.5)
	Pad(card, 10, 8, 10, 8)
	List(card, 6)

	local sec = setmetatable({
		Window = self.Window, Tab = self, Holder = holder, Card = card, Items = {}, _order = 0,
	}, SectionClass)

	table.insert(self.Sections, sec)
	return sec
end

-- ---------- уведомления ----------

function WindowClass:Notify(cfg)
	if type(cfg) == "string" then
		cfg = { Content = cfg }
	end
	cfg = cfg or {}

	local card = New("CanvasGroup", {
		BackgroundColor3 = Theme.Popup, GroupTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = self.Notifs,
	})
	Corner(card, 8)
	Stroke(card, Theme.Stroke, 0.2)

	local bar = New("Frame", { BackgroundColor3 = Theme.Accent, Size = UDim2.new(0, 3, 1, 0), Parent = card })

	local body = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
	Pad(body, 14, 8, 10, 8)
	List(body, 2)

	local t = New("TextLabel", {
		Text = cfg.Title or "Blossom", TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1, Parent = body,
	})
	t.Font = Enum.Font.GothamBold

	New("TextLabel", {
		Text = cfg.Content or "", TextColor3 = Theme.SubText, TextSize = 12, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = body,
	})

	Tween(card, { GroupTransparency = 0 }, 0.2)

	task.delay(cfg.Duration or 4, function()
		Tween(card, { GroupTransparency = 1 }, 0.25)
		task.wait(0.3)
		card:Destroy()
	end)
end

-- ---------- выгрузка ----------

function WindowClass:Unload()
	for _, c in ipairs(Blossom.Signals) do
		pcall(function() c:Disconnect() end)
	end

	table.clear(Blossom.Signals)
	table.clear(Blossom.Flags)
	table.clear(Blossom.Themed)

	self.Gui:Destroy()
end

-- ===================== конфиги =====================

local function Encode(el)
	if el.Type == "ColorPicker" then
		local c = el:Get()
		return { R = c.R, G = c.G, B = c.B }
	end
	return el:Get()
end

local function Decode(el, v)
	if el.Type == "ColorPicker" then
		el:Set(Color3.new(v.R, v.G, v.B))
	else
		el:Set(v)
	end
end

function Blossom:_Path(name)
	return self.Folder .. "/" .. name .. ".json"
end

function Blossom:SaveConfig(name)
	if not (writefile and makefolder and isfolder) then
		return false, "файловые функции недоступны"
	end

	if not isfolder(self.Folder) then
		makefolder(self.Folder)
	end

	local data = {}
	for flag, el in pairs(self.Flags) do
		local ok, value = pcall(Encode, el)
		if ok and value ~= nil then
			data[flag] = value
		end
	end

	writefile(self:_Path(name), HttpService:JSONEncode(data))
	return true
end

function Blossom:LoadConfig(name)
	if not (readfile and isfile) or not isfile(self:_Path(name)) then
		return false, "конфиг не найден"
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(self:_Path(name)))
	end)
	if not ok then
		return false, "повреждённый конфиг"
	end

	for flag, value in pairs(data) do
		local el = self.Flags[flag]
		if el then
			pcall(Decode, el, value)
		end
	end

	return true
end

function Blossom:ListConfigs()
	local out = {}

	if listfiles and isfolder and isfolder(self.Folder) then
		for _, path in ipairs(listfiles(self.Folder)) do
			local n = path:match("([^/\\]+)%.json$")
			if n then
				table.insert(out, n)
			end
		end
	end

	return out
end

return Blossom

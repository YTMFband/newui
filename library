-- Блок, который показывается только если условия выполнены (как DependencyBox в Linoria).
-- Скрытый блок не занимает места: всё ниже поднимается вверх.
function Elements:AddDependencyBox()
	local Depbox = { Type = "Depbox", Window = self.Window, Dependencies = {} }

	local holder = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = self.Container,
	})
	List(holder, 4)
	Depbox.Container = holder
	Mixin(Depbox)

	local function resolve(el)
		if type(el) == "string" then
			return Library.Toggles[el] or Library.Options[el]
		end
		return el
	end

	function Depbox:Update()
		for _, dep in ipairs(self.Dependencies) do
			local el, expected = resolve(dep[1]), dep[2]
			if not el then
				holder.Visible = false
				return
			end
			local ok
			if el.Type == "Dropdown" and el.Multi then
				ok = el.Value[expected] == true
			else
				ok = el.Value == expected
			end
			if not ok then
				holder.Visible = false
				return
			end
		end
		holder.Visible = true
	end

	-- deps = { { Toggles.esp_enable, true }, { Options.mode, "Box" } }  или { { "esp_enable", true } }
	function Depbox:SetupDependencies(deps)
		self.Dependencies = deps
		for _, dep in ipairs(deps) do
			local el = resolve(dep[1])
			if el then
				el:OnChanged(function()
					self:Update()
				end)
			end
		end
		self:Update()
	end

	return Depbox
end


local Elements = {}

local function Mixin(obj)
	for k, fn in pairs(Elements) do
		obj[k] = fn
	end
end

local function BuildSettings(window, right, order)
	local S = { Type = "Settings", Window = window }
	local gear = New("TextButton", {
		Size = UDim2.fromOffset(14, 14),
		BackgroundTransparency = 1,
		Text = Library.Icons.Gear and "" or "⚙",
		TextColor3 = T.SubText,
		Font = T.Font,
		TextSize = 15,
		LayoutOrder = order or 2,
		Parent = right,
	})
	if Library.Icons.Gear then
		New("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,

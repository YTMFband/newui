function Elements:AddSlider(id, o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local S = {
		Type = "Slider",
		Min = min,
		Max = max,
		Rounding = o.Rounding or 0,
		Suffix = o.Suffix or "",
		Value = o.Default or min,
		_callback = o.Callback,
	}
	AttachChanged(S)

	local row = MakeRow(self.Container, 36)
	MakeText(row, o.Text or id or "", { Size = UDim2.new(1, -80, 0, 16) })
	-- счётчик справа в маленьком боксе; значение можно ввести вручную
	local valueLabel = New("TextBox", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, -1),
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = T.Element,
		BackgroundTransparency = 0.3,
		Text = "",
		TextColor3 = T.SubText,
		Font = T.Font,
		TextSize = 11,
		ClearTextOnFocus = false,
		Parent = row,
	})
	Corner(valueLabel, 4)
	Pad(valueLabel, 6, 0, 6, 0)
	New("UISizeConstraint", { MinSize = Vector2.new(38, 18), Parent = valueLabel })
	valueLabel.Focused:Connect(function()
		valueLabel.TextColor3 = T.Text
	end)
	valueLabel.FocusLost:Connect(function()
		valueLabel.TextColor3 = T.SubText
		local n = tonumber((valueLabel.Text:gsub("[^%d%.%-]", "")))
		if n then
			S:SetValue(n)
		else
			S:SetValue(S.Value, true)
		end
	end)
	local hit = New("TextButton", {
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundTransparency = 1,
		Text = "",
		Parent = row,
	})
	local bar = New("Frame", {
		Position = UDim2.new(0, 0, 0.5, -3),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = T.Element,
		Parent = hit,
	})
	Corner(bar, 3)
	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = bar,
	})
	Corner(fill, 3)
	Gradient(fill, 0)
	-- круглый бегунок на конце полосы
	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12),
		Position = UDim2.new(0, 6, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(226, 226, 250),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = bar,
	})
	Corner(knob, 6)

	function S:SetValue(val, silent)
		val = math.clamp(tonumber(val) or self.Min, self.Min, self.Max)
		local m = 10 ^ self.Rounding
		val = math.floor(val * m + 0.5) / m
		self.Value = val
		local a = (self.Max == self.Min) and 0 or (val - self.Min) / (self.Max - self.Min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 6 - 12 * a, 0.5, 0) -- центр бегунка не выходит за края полосы
		valueLabel.Text = string.format("%." .. self.Rounding .. "f", val) .. self.Suffix
		if not silent then
			self:_fire()
		end
	end

	hit.InputBegan:Connect(function(input)
		if IsPress(input) then
			local function f(pos, inp)
				local a = math.clamp((PointerPos(pos, inp).X - hit.AbsolutePosition.X) / hit.AbsoluteSize.X, 0, 1)
				S:SetValue(S.Min + (S.Max - S.Min) * a)
			end
			f(input.Position, input)
			BeginDrag(f)
		end
	end)

	Register(id, S)
	S:SetValue(S.Value, true)
	return S
end

function Elements:AddDropdown(id, o)
	o = o or {}
	local D = {
		Type = "Dropdown",
		Values = o.Values or {},
		Multi = o.Multi == true,
		_callback = o.Callback,
	}
	AttachChanged(D)
	D.Value = D.Multi and {} or nil

	local row = MakeRow(self.Container, 24)
	MakeText(row, o.Text or id or "", { Size = UDim2.new(1, -130, 1, 0) })
	local btn = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(120, 20),
		BackgroundColor3 = T.Element,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
		Parent = row,
	})
	Corner(btn, 4)
	Stroke(btn)
	local btnText = MakeText(btn, "None", {
		Size = UDim2.new(1, -18, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		TextSize = 12,
		TextColor3 = T.SubText,
	})
	MakeText(btn, "v", {
		Size = UDim2.fromOffset(12, 20),
		Position = UDim2.new(1, -14, 0, 0),
		TextSize = 11,
		TextColor3 = T.SubText,
	})

	local pop = New("ScrollingFrame", {
		Size = UDim2.fromOffset(120, 100),
		BackgroundColor3 = T.Background,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = Library.Overlay,
	})
	Corner(pop, 6)
	Stroke(pop)
	Pad(pop, 4, 4, 4, 4)
	List(pop, 2)

	local items = {}

	local function refresh()
		local text
		if D.Multi then
			local t = {}
			for _, name in ipairs(D.Values) do
				if D.Value[name] then
					table.insert(t, name)
				end
			end
			text = #t > 0 and table.concat(t, ", ") or "None"
		else
			text = D.Value or "None"
		end
		btnText.Text = tostring(text)
		btnText.TextColor3 = (text == "None") and T.SubText or T.Text
		for name, b in pairs(items) do
			local sel = D.Multi and D.Value[name] or (not D.Multi and D.Value == name)
			b.TextColor3 = sel and T.Accent or T.Text
		end
	end

	local function build()
		for _, b in pairs(items) do
			b:Destroy()
		end
		table.clear(items)
		for i, name in ipairs(D.Values) do
			local b = New("TextButton", {
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundColor3 = T.Element,
				BackgroundTransparency = 1,
				Text = "  " .. tostring(name),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = T.Text,
				Font = T.Font,
				TextSize = 12,
				AutoButtonColor = false,
				LayoutOrder = i,
				Parent = pop,
			})
			Corner(b, 4)
			b.MouseEnter:Connect(function()
				Tween(b, { BackgroundTransparency = 0 }, 0.1)
			end)
			b.MouseLeave:Connect(function()
				Tween(b, { BackgroundTransparency = 1 }, 0.1)
			end)
			b.MouseButton1Click:Connect(function()
				if D.Multi then
					D.Value[name] = not D.Value[name] or nil
				else
					D.Value = name
					Library:_closeFrame(pop)
				end
				refresh()
				D:_fire()
			end)
			items[name] = b
		end
		pop.Size = UDim2.fromOffset(120, math.min(#D.Values * 22 + 8, 150))
		refresh()
	end

	function D:SetValue(val, silent)
		if self.Multi then
			local new = {}
			if type(val) == "table" then
				for k, x in pairs(val) do
					if type(k) == "number" then
						new[x] = true
					elseif x then
						new[k] = true
					end
				end
			end
			self.Value = new
		else
			self.Value = val
		end
		refresh()
		if not silent then
			self:_fire()
		end
	end

	function D:SetValues(list)
		self.Values = list
		if self.Multi then
			self.Value = {}
		else
			self.Value = nil
		end
		build()
	end

	function D:GetSelected()
		if not self.Multi then
			return self.Value and { self.Value } or {}
		end
		local t = {}
		for _, name in ipairs(self.Values) do
			if self.Value[name] then
				table.insert(t, name)
			end
		end
		return t
	end

	btn.MouseButton1Click:Connect(function()
		pop.Size = UDim2.fromOffset(btn.AbsoluteSize.X, pop.Size.Y.Offset)
		Library:_togglePopup(pop, btn)
	end)

	Register(id, D)
	build()
	local def = o.Default
	if type(def) == "number" then
		def = D.Values[def]
	end
	if def ~= nil then
		D:SetValue(D.Multi and (type(def) == "table" and def or { def }) or def, true)
	end
	return D
end

function Elements:AddKeybind(id, o)
	o = o or {}
	local K = {
		Type = "Keybind",
		Mode = o.Mode or "Toggle", -- Toggle / Hold / Press
		State = false,
		Value = o.Default,
		_callback = o.Callback,
		_changedKey = o.ChangedCallback,
	}
	AttachChanged(K)

	local row = MakeRow(self.Container, 22)
	MakeText(row, o.Text or id or "", { Size = UDim2.new(1, -80, 1, 0) })
	local btn = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(70, 18),
		BackgroundColor3 = T.Element,
		TextColor3 = T.SubText,
		Font = T.Font,
		TextSize = 11,
		AutoButtonColor = false,
		ZIndex = 2,
		Parent = row,
	})
	Corner(btn, 4)
	Stroke(btn)

	local listening = false
	local function label()
		btn.Text = listening and "..." or ("[" .. (K.Value and K.Value.Name or "None") .. "]")
	end

	function K:SetValue(key, silent)
		if type(key) == "string" then
			local ok, kc = pcall(function()
				return Enum.KeyCode[key]
			end)
			key = ok and kc or nil
		end
		self.Value = key
		label()
		if not silent then
			Safe(self._changedKey, key)
		end
	end

	function K:GetState()
		return self.State
	end

	btn.MouseButton1Click:Connect(function()
		listening = true
		label()
	end)

	Connect(UIS.InputBegan, function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				K:SetValue(input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode or nil)
			end
			return
		end
		if gp or not K.Value or input.KeyCode ~= K.Value then
			return
		end
		if K.Mode == "Toggle" then
			K.State = not K.State
			K:_fire(K.State)
		elseif K.Mode == "Hold" then
			K.State = true
			K:_fire(true)
		else
			K:_fire(true)
		end
	end)

	Connect(UIS.InputEnded, function(input)
		if K.Mode == "Hold" and K.Value and input.KeyCode == K.Value and K.State then
			K.State = false
			K:_fire(false)
		end
	end)

	Register(id, K)
	label()
	return K
end

